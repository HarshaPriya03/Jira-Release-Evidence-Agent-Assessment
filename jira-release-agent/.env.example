# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# --- LLM provider: gemini (free tier, default) or anthropic (paid) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-from-aistudio.google.com/apikey
LLM_MODEL=gemini-3.5-flash-lite
# Seconds between model calls (keeps you under typical free-tier requests/minute).
# Raise it (e.g. 12) if you see rate-limit retries; lower it if your quota allows.
LLM_MIN_INTERVAL_SECONDS=6.5
# ANTHROPIC_API_KEY=...   (only if LLM_PROVIDER=anthropic)

# Optional importer settings
JIRA_ISSUE_TYPE=Task
JIRA_LINK_TYPE=Relates

# Optional agent budgets (all enforced in code)
JRA_MAX_TURNS=100
JRA_MAX_TOOL_CALLS=200
JRA_MAX_WALL_SECONDS=2400
JRA_MAX_TOTAL_TOKENS=1500000
JRA_TOOL_RESULT_CHARS=7000
